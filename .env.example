# Telegram Bot API token, from @BotFather
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram chat ID. The bot only responds to this chat.
# You can get this from @userinfobot on Telegram.
TELEGRAM_CHAT_ID=

# Gemini API key, from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use for text generation (default shown)
GEMINI_MODEL=gemini-3.6-flash

# Postgres connection string. On Vercel, install the Supabase integration
# from the Marketplace, then set this to the provisioned
# POSTGRES_URL_NON_POOLING value (not the pooled one - see README).
DATABASE_URL=

# Optional: minimum number of LinkedIn posts required before /analyze will run (default shown)
MIN_POSTS_FOR_ANALYSIS=5

# Optional: minimum Gemini content score (0.0-10.0) a note must reach to pass
# the gate into Google News + drafting (default shown)
MIN_CONTENT_SCORE=6.0

# Optional: log level - debug | info | warn | error (default shown)
LOG_LEVEL=info

# --- Only needed for the Vercel webhook deployment, not local polling mode ---

# A random string (e.g. `openssl rand -hex 24`) Telegram will echo back on
# every webhook request so you can verify it's really Telegram calling you.
TELEGRAM_WEBHOOK_SECRET=

# Your deployed Vercel URL (e.g. https://your-app.vercel.app), used only by
# `npm run set-webhook` to register the webhook with Telegram.
PUBLIC_URL=
